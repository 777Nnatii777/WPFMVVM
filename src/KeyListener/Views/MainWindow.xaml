<Window x:Class="KeyListener.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Key Listener" Height="450" Width="800">
    <StackPanel Margin="20">
        <Button Content="Start" Command="{Binding StartCommand}" />
        <Button Content="Stop" Command="{Binding StopCommand}" />
        <Button Content="Pokaz statystyki" Command="{Binding ShowStatsCommand}" />

        <ListView ItemsSource="{Binding Stats}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Klawisz" DisplayMemberBinding="{Binding Key}" />
                    <GridViewColumn Header="Liczba" DisplayMemberBinding="{Binding Count}" />
                    <GridViewColumn Header="%" DisplayMemberBinding="{Binding Percentage}" />
                </GridView>
            </ListView.View>
        </ListView>
    </StackPanel>
</Window>
