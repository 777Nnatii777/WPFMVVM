<Window x:Class="KeyListener.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Key Listener" Height="500" Width="800"
        Background="#1E1E2F"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
       
        <Style x:Key="FancyButton" TargetType="Button">
            <Setter Property="Background" Value="#3E3E55"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="MinHeight" Value="60"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5E5EFF"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

         
            <Border Background="#2E2E40" Padding="20" CornerRadius="10" Margin="0 0 0 20">
                <TextBlock Text="{Binding ElapsedTime}"
                           FontSize="36"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource FancyButton}" Content="Start" Command="{Binding StartCommand}" />
                <Button Style="{StaticResource FancyButton}" Content="Stop" Command="{Binding StopCommand}" />
                <Button Style="{StaticResource FancyButton}" Content="Pokaż wyniki" Command="{Binding ShowStatsCommand}" />
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
