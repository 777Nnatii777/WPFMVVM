<Window x:Class="KeyListener.Views.StatsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Statystyki"
        Height="500"
        Width="700"
        Background="#1E1E2F"
        WindowStartupLocation="CenterScreen">

	<Window.Resources>
		
		<Style TargetType="GridViewColumnHeader">
			<Setter Property="Background" Value="#2E2E40"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Padding" Value="10,5"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
		</Style>

		
		<Style TargetType="ListViewItem">
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Padding" Value="8,4"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="#3E3E55"/>
			<Setter Property="BorderThickness" Value="0,0,0,1"/>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="#3A3A55"/>
				</Trigger>
				<Trigger Property="IsSelected" Value="True">
					<Setter Property="Background" Value="#5E5EFF"/>
					<Setter Property="Foreground" Value="White"/>
				</Trigger>
			</Style.Triggers>
		</Style>
	</Window.Resources>

	<Grid Margin="20">
		<Border Background="#2E2E40" Padding="15" CornerRadius="10">
			<StackPanel>

				<TextBlock Text="Statystyki klawiszy"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 15"/>

				<ListView ItemsSource="{Binding Stats}"
          Background="#1E1E2F"
          BorderThickness="0"
          Foreground="White"
          FontSize="16"
          ScrollViewer.VerticalScrollBarVisibility="Auto"
          Margin="0">
					<ListView.View>
						<GridView>
							<GridViewColumn Header="Klawisz" DisplayMemberBinding="{Binding Key}" Width="200"/>
							<GridViewColumn Header="Liczba" DisplayMemberBinding="{Binding Count}" Width="150"/>
							<GridViewColumn Header="%" DisplayMemberBinding="{Binding Percentage}" Width="150"/>
						</GridView>
					</ListView.View>
				</ListView>
				

			</StackPanel>
		</Border>
	</Grid>
</Window>
